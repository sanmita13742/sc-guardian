flowchart LR
  USER([Analyst / CI pipeline]) -->|repo URL, options| UI[Streamlit UI + guardian.py CLI]
  UI --> SUP{{Supervisor: plan, observe, adapt}}

  subgraph SRC[Data sources - read only, cached]
    GH[(Public GitHub repo - shallow safe clone)]
    VDB[(OSV, NVD, CISA KEV, EPSS)]
    REG[(deps.dev, npm, PyPI, crates.io, Maven Central, Packagist, RubyGems, Go checksum DB)]
  end

  subgraph AGENTS[LangGraph agent pipeline - deterministic by default]
    RECON[Recon Agent] --> PIPE[Pipeline Agent: Dockerfile, compose, CI/CD rules]
    PIPE --> SBOM[SBOM Agent: Syft / Trivy / rule engine + metadata fusion + digest check]
    SBOM --> GRAPH[Graph Agent: dependency graph]
    GRAPH --> VULN[Vulnerability Agent] --> VER[Verification Agent: 2nd OSV route] --> INV[Investigator Agent: reachability, EPSS, verdict]
    GRAPH --> THREAT[Threat Agent: typosquat, lockfile history, package risk, provenance]
    INV --> RISK[Risk Agent: score, confidence, P0-P3]
    THREAT --> RISK
    RISK --> REM[Remediation Agent: smallest safe change]
    REM --> VAL[Validator Agent: what-if rescan, SBOM diff, patch check]
    VAL --> MEM[Memory Agent: history, decisions]
    MEM --> REPORT[Analyst Agent: Guardian report, SARIF, VEX]
  end

  SUP --> RECON
  GH --> RECON
  VDB --> VULN
  VDB --> INV
  REG --> SBOM
  REG --> REM

  subgraph AI[Optional AI - off unless LLM_API_KEY is set]
    LLM{{LLM: Groq / Gemini / Claude / OpenAI-compatible}}
    GATE[Grounding gate: cited evidence only, no contradictions]
  end
  TOOLS[[Read-only tool registry]] --- INV
  INV -. proposes verdict + rationale .-> LLM
  LLM -.-> GATE
  GATE -. accepted or rejected .-> INV

  EVID[(Evidence store: every fact has an id)]
  INV --> EVID
  PIPE --> EVID
  VAL --> EVID
  DB[(SQLite: scans, memory, approvals, audit log, graph, cache)]
  MEM --> DB
  REPORT --> DB

  REPORT --> APPROVE{Human approval}
  APPROVE -->|approved| EXPORT[Patch + PR text export]
  APPROVE -->|optional, approved| SANDBOX[Docker sandbox: build + tests, network off for tests]
  APPROVE -->|rejected / needs review| DB
  POLICY[Policy-as-code YAML] --> GATEOUT{CI gate: exit code}
  REPORT --> POLICY
  MON[Monitor Agent: re-assess stored inventories] --> DB
  VDB --> MON
