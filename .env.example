# Optional: NVD API key (raises NVD rate limits). The scanner works without it.
NVD_API_KEY=
# Optional: enables LLM-written explanations (grounded + validated; falls back to templates).
ANTHROPIC_API_KEY=
EXPLAIN_LLM_MODEL=claude-sonnet-5-5
# Optional overrides
SCANNER_DATA_DIR=./data
SCANNER_WORKSPACE_DIR=./.workspaces
SYFT_BIN=
TRIVY_BIN=
