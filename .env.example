# LLM Provider API Key (Groq: gsk_..., Gemini: AIza..., Anthropic: sk-ant-..., OpenAI: sk-...)
# Add your API key below to enable autonomous AI agent investigations and natural language reasoning
LLM_API_KEY=

# Optional: NVD API Key for higher rate limits
NVD_API_KEY=

# Local storage and workspace paths
SCANNER_DATA_DIR=./data
SCANNER_WORKSPACE_DIR=./.workspaces

# Optional scanner binaries (auto-detected if on PATH)
SYFT_BIN=
TRIVY_BIN=
# Optional: typed-decision model for the Fix Validation Agent (OpenRouter /api/alpha/decisions)
OPENROUTER_API_KEY=
