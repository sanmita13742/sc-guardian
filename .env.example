# Optional: NVD API key (raises NVD rate limits). The scanner works without it.
NVD_API_KEY=
# Optional LLM (everything works without it - deterministic mode). Paste ONE key: Groq (gsk_...), Gemini (AIza...), Anthropic (sk-ant-...) or OpenAI-compatible.
# The provider is detected from the key prefix. Used only for agent reasoning text; every output is validated against collected evidence.
LLM_API_KEY=
#LLM_PROVIDER=groq
#LLM_MODEL=
#LLM_BASE_URL=
# Optional overrides
SCANNER_DATA_DIR=./data
SCANNER_WORKSPACE_DIR=./.workspaces
SYFT_BIN=
TRIVY_BIN=
